# API (artifacts/api-server). Copy to .env.local and fill in. Never commit real values.
NODE_ENV=production
PORT=8080
# Postgres connection string (dev falls back to embedded PGlite). Connect as the role that OWNS the tables.
DATABASE_URL=
# one connection is held per in-flight authenticated request
DB_POOL_MAX=10
# database-level tenant isolation; 0 only if the database cannot create/grant the cspm_app role
RLS_ENFORCE=1
# 32+ random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=
APP_ORIGINS=https://cspm.onenexora.com,https://app.cspm.onenexora.com
APP_URL=https://app.cspm.onenexora.com
# set when behind a load balancer so rate limits see real IPs
TRUST_PROXY=1
# Nexora single sign-on: shared with onenexora.com, which signs short-lived tokens
# 32+ random characters; the same value goes into the Nexora console (see replica/nexora-sso.md)
SSO_SECRET=
# Billing (create the Stripe account yourself; use test keys until deploy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# optional, printed by deploy/stripe-test-setup.mjs when the default portal does not allow cancelling
STRIPE_PORTAL_CONFIG=
STRIPE_PRICE_STARTER=
# AWS connector (off unless set). NEXORA's own AWS account id; the process also needs AWS credentials that may call sts:AssumeRole,
# from the standard chain (instance/task role preferred). See replica/aws-setup.md.
# 12 digits
CSPM_AWS_ACCOUNT_ID=

# Email (Resend). Create the account and verify the sending domain yourself, see replica/email-setup.md.
# Without RESEND_API_KEY: development prints emails to the server console; production sends nothing.
# restrict the key to "Sending access" on your domain
RESEND_API_KEY=
# e.g. NEXORA CSPM <no-reply@mail.cspm.onenexora.com> (required when the key is set)
MAIL_FROM=
# Optional: LLM explanations. Without it the evidence-only text is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Front ends (build-time)
# artifacts/cspm-site:  VITE_APP_URL=https://app.cspm.onenexora.com  VITE_API_URL=https://api.cspm.onenexora.com
# artifacts/cspm-app:   VITE_API_URL=https://api.cspm.onenexora.com

# Copy to .env on the server (chmod 600) and fill in. Never commit .env.
# Hostnames: three DNS A records pointing at the VM's public IP.
SITE_HOST=cspm.onenexora.com
APP_HOST=app.cspm.onenexora.com
API_HOST=api.cspm.onenexora.com
# Let's Encrypt contact (expiry notices)
ACME_EMAIL=you@example.com

# Required secrets: generate with  openssl rand -base64 36  (JWT) and  openssl rand -base64 24  (database)
JWT_SECRET=
POSTGRES_PASSWORD=

# Optional features (leave empty until you have set each one up; see replica/*.md)
# Nexora single sign-on, 32+ characters, the same value as in the Nexora console
SSO_SECRET=
# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=
# Billing (Stripe; test keys first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PORTAL_CONFIG=
# AI explanations (otherwise rule-based text)
ANTHROPIC_API_KEY=
# AWS connector: NEXORA's own AWS account id (12 digits); see replica/aws-setup.md
CSPM_AWS_ACCOUNT_ID=

# Tuning (defaults are fine for one small VM)
DB_POOL_MAX=10
# For testing the stack on a laptop only: HTTP_PORT=8080 HTTPS_PORT=8443 CADDY_GLOBAL_OPTIONS=local_certs
